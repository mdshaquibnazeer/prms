# Copy this file to ".env" in the PROJECT ROOT (same folder as this file) and edit the values.
# NEVER commit the real .env file.

# PostgreSQL connection string:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/patient_records

# Secret used to sign login tokens. Use a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Optional
PORT=5000
JWT_EXPIRES_IN=8h
# Address of the React app (used for CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173
